#include <windows.h>

101 ICON "../resources/wavy-flo.ico"
1 RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Wavy-Flo"
      VALUE "FileDescription", "Wavy-Flo Setup"
      VALUE "ProductName", "Wavy-Flo"
      VALUE "OriginalFilename", "Wavy-Flo Setup.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
